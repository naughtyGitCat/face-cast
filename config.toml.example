# face-cast 本地配置. 复制成 config.toml 后填真值.
# 默认放在跟 face_cast.db 同目录 (e.g. E:\face-cast\config.toml).
# 也可用 --config <path> 或 $FACE_CAST_CONFIG 指定.
#
# 注意: config.toml 已在 .gitignore, 不要把含 api_key 的版本提交上去.

[jellyfin]
url = "http://10.100.100.13:8096"
api_key = ""  # Jellyfin Dashboard → 高级 → API 密钥

[server]
# face-cast inference server (GPU 机). 不配的话 /browse 上的扫描按钮会拒绝.
# 默认端口 :9000 (face-cast extract 的 typer 默认).
url = "http://10.100.100.11:9000"

[scan]
frames = 15  # 每个视频抽多少帧
